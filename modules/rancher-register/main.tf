###############################################################################
# modules/rancher-register — register THE CALLING cluster into Rancher and install its agent.
#
# Each fleet cluster's stack calls this so the cluster registers ITSELF (same decentralised pattern
# as each cluster self-bootstrapping Argo CD). It:
#   1. creates an imported `rancher2_cluster` in the Rancher instance, then
#   2. applies that cluster's registration manifest to the cluster (installs cattle-cluster-agent +
#      fleet-agent — the agent then dials out to Rancher), and
#   3. (optional) creates a per-tenant Rancher Project + project-member binding on this cluster.
#
# Why a local-exec (not `kubectl_manifest`): Rancher's registration YAML is MULTI-DOC and its
# content is only known at APPLY time (it embeds the per-cluster token generated by
# `rancher2_cluster.self` in this same apply). A `kubectl_manifest` for_each/count over that content
# can't be planned, so it is incompatible with a single `terraform apply`. We instead apply it the
# way Rancher documents (`curl | kubectl apply`).
###############################################################################
terraform {
  required_providers {
    rancher2 = { source = "rancher/rancher2" }
    null     = { source = "hashicorp/null", version = "~> 3.2" }
  }
}

# Throwaway kubeconfig built from THIS cluster's credentials (the same values the caller feeds the
# kubectl/kubernetes providers). In CI these come from `module.cluster` outputs, populated by the
# azurerm provider via the pipeline's OIDC/SP — no ambient kube-context required.
# cluster_ca_certificate / client_certificate / client_key are already base64, which is exactly what
# kubeconfig's *-data fields expect, so they are passed through verbatim.
locals {
  kubeconfig = yamlencode({
    apiVersion = "v1"
    kind       = "Config"
    clusters = [{
      name = "target"
      cluster = {
        server                       = var.cluster_host
        "certificate-authority-data" = var.cluster_ca_certificate
      }
    }]
    users = [{
      name = "target"
      user = {
        "client-certificate-data" = var.client_certificate
        "client-key-data"         = var.client_key
      }
    }]
    contexts = [{
      name    = "target"
      context = { cluster = "target", user = "target" }
    }]
    "current-context" = "target"
  })
}

# 1) Imported cluster object in Rancher.
resource "rancher2_cluster" "self" {
  name = var.cluster_name
  labels = {
    "platform.internal/managed-by" = "platform-terraform"
  }

  # Rancher adds its own managed labels/annotations (e.g. provider.cattle.io, auth-image) after
  # import; don't fight that churn on every apply.
  lifecycle {
    ignore_changes = [labels, annotations]
  }
}

# 2) Install the agent by applying the registration manifest to this cluster (self-signed -> --insecure).
resource "null_resource" "register" {
  triggers = {
    cluster      = var.cluster_name
    manifest_url = rancher2_cluster.self.cluster_registration_token[0].manifest_url
  }

  provisioner "local-exec" {
    interpreter = ["/bin/bash", "-c"]
    environment = {
      KUBECONFIG_CONTENT = local.kubeconfig
      MANIFEST_URL       = rancher2_cluster.self.cluster_registration_token[0].manifest_url
    }
    command = <<-CMD
      set -euo pipefail
      KUBECONFIG_FILE="$(mktemp)"
      trap 'rm -f "$KUBECONFIG_FILE"' EXIT
      printf '%s' "$KUBECONFIG_CONTENT" > "$KUBECONFIG_FILE"
      curl --insecure -sfL "$MANIFEST_URL" | kubectl --kubeconfig "$KUBECONFIG_FILE" apply -f -
    CMD
  }
}

# 3) 1:1 team=Project — one Rancher Project per tenant on THIS cluster + project-member for its GitHub
#    team. Driven directly by var.tenants (empty map => none); the generated `<clusterId>:<projectId>`
#    id is exported via tenant_project_ids and fed to the Argo in-cluster Secret by the caller.
resource "rancher2_project" "tenant" {
  for_each   = var.tenants
  name       = each.key
  cluster_id = rancher2_cluster.self.id
}

resource "rancher2_project_role_template_binding" "tenant_member" {
  # Only bind when a group principal is provided (needs Rancher GitHub/IdP auth). Omit it (empty
  # principal) to create the Project alone — useful for testing the namespace->Project mapping
  # before IdP auth is wired.
  for_each           = { for t, v in var.tenants : t => v if v.group_principal_id != "" }
  name               = "${each.key}-member"
  project_id         = rancher2_project.tenant[each.key].id
  role_template_id   = "project-member"
  group_principal_id = each.value.group_principal_id
}
